{
  "name": "mysterycut",
  "version": "0.1.0",
  "private": true,
  "description": "mystery.cut 인스타 릴스 자동화 파이프라인 (스토리 구상 → 대본 → 영상제작 → 업로드)",
  "type": "module",
  "scripts": {
    "pipeline": "tsx src/index.ts",
    "ideate": "tsx src/index.ts --only=ideate",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "tsx src/render.ts",
    "setup-instagram": "tsx src/tools/setupInstagram.ts",
    "refresh-token": "tsx src/tools/refreshInstagramToken.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "dotenv": "^16.4.5",
    "msedge-tts": "^1.3.4",
    "music-metadata": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
