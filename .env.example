# ── 스토리/대본/캡션 생성: Google Gemini (무료 등급) ──────────────
# https://aistudio.google.com/apikey 에서 무료 발급. 하루 몇 개는 무료 한도 안.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 나레이션: Microsoft Edge TTS (무료, 키 불필요) ────────────────
# 한국어 뉴럴 음성. 다른 목소리: ko-KR-InJoonNeural(남), ko-KR-SunHiNeural(여)
TTS_VOICE=ko-KR-SunHiNeural
TTS_RATE=-8%
TTS_PITCH=-4Hz

# ── Instagram Graph API 자동 업로드 (무료) ───────────────────────
# 인스타 프로페셔널(비즈니스/크리에이터) 계정 + Facebook 페이지 연동 필요.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# ── 토큰 자동 갱신용 (Facebook 앱 자격증명) ──────────────────────
# 60일마다 만료되는 장기 토큰을 자동 재발급하는 데 사용.
FB_APP_ID=
FB_APP_SECRET=

# ── 최초 셋업용 (npm run setup-instagram 실행 시에만 임시로 사용) ──
# Graph API Explorer 에서 받은 사용자 토큰. 셋업 후에는 지워도 됩니다.
FB_USER_TOKEN=
# 연결된 페이지가 여러 개일 때 이름으로 지정 (선택)
PAGE_NAME=Mystery.cut

# 채널 톤/주제 (스토리 구상 시 프롬프트에 반영)
CHANNEL_LANGUAGE=한국어
CHANNEL_NICHE=미스터리, 실제 미제사건, 도시전설, 역사 속 미스터리
