# ── 스토리/대본/캡션 생성: Google Gemini (무료 등급) ──────────────
# https://aistudio.google.com/apikey 에서 무료 발급. 하루 몇 개는 무료 한도 안.
GEMINI_API_KEY=
# 비워두면 최신 무료 flash 모델을 자동으로 선택합니다.
GEMINI_MODEL=gemini-3-flash

# ── 나레이션 TTS ─────────────────────────────────────────────────
# 기본은 Edge TTS(무료, 키 불필요). GOOGLE_TTS_API_KEY 를 넣으면 자동으로
# 더 자연스러운 Google Cloud TTS(무료 등급 내)를 사용합니다.
# TTS_PROVIDER=edge  (또는 google 강제)
TTS_VOICE=ko-KR-InJoonNeural
TTS_RATE=-10%
TTS_PITCH=-3Hz
# 더 자연스러운 무료 목소리: Google Cloud TTS Neural2 (하루 2개는 무료 한도 내)
# https://console.cloud.google.com → Text-to-Speech API 사용 설정 → API 키
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ko-KR-Neural2-C

# ── 배경 자료화면: Pexels 무료 스톡 ──────────────────────────────
# https://www.pexels.com/api/ 에서 무료 발급. 없으면 배경 없이 그라디언트.
PEXELS_API_KEY=

# ── BGM (선택) ───────────────────────────────────────────────────
# public/bgm/ 에 mp3 를 넣으면 자동으로 깔립니다. (저작권 무료 음원 권장)
# 또는 GitHub Secrets 에 BGM_URL(직접 다운로드 링크) 설정.
BGM_VOLUME=0.14

# ── Instagram 자동 업로드 (무료) ─────────────────────────────────
# 방식 선택:
#   instagram_login = graph.instagram.com, Facebook 페이지 불필요 (권장·기본)
#   facebook_login  = graph.facebook.com, 연결된 FB 페이지 필요
IG_API_MODE=instagram_login
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# ── 앱 자격증명 ──────────────────────────────────────────────────
# instagram_login: 최초 장기 토큰 교환 시 FB_APP_SECRET(=Instagram app secret)만 있으면 됨.
#                  이후 토큰 갱신에는 시크릿이 필요 없음.
# facebook_login : FB_APP_ID + FB_APP_SECRET 둘 다 필요(갱신 포함).
FB_APP_ID=
FB_APP_SECRET=

# ── 최초 셋업용 (npm run setup-instagram 실행 시에만 임시 사용) ────
# instagram_login: 앱 대시보드 "Generate access tokens" 토큰
# facebook_login : Graph API Explorer 사용자 토큰
IG_USER_TOKEN=
# facebook_login 에서 페이지가 여러 개일 때 이름 지정 (선택)
PAGE_NAME=Mystery.cut

# 채널 톤/주제 (스토리 구상 시 프롬프트에 반영)
CHANNEL_LANGUAGE=한국어
CHANNEL_NICHE=미스터리, 실제 미제사건, 도시전설, 역사 속 미스터리
